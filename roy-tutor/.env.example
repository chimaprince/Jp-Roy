# Qwen is the tutor's only AI provider (Alibaba Cloud Model Studio,
# OpenAI-compatible API). Put the real key only in .env, never in code or Git.
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen3.8-flash
# QWEN_BASE_URL=https://ws-c2mgxehx4ud1bn7.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# QWEN_ENABLE_THINKING=false

# TUTOR_TIMEZONE=Asia/Shanghai

# Voice (server side; the browser never talks to Qwen). Singapore defaults:
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash
# Singapore workspace-specific host (Model Studio › your Singapore
# workspace; replace <WORKSPACE_ID> with the workspace ID). For
# qwen-audio-*-asr models the tutor calls the DashScope native endpoint on
# this host: https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# QWEN_ASR_BASE_URL=https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Or give the ASR endpoint in full (overrides the one derived above):
# QWEN_ASR_URL=https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Lesson-term recognition context (on by default): QWEN_ASR_CONTEXT=off to disable
# QWEN_ASR_CONTEXT=on
# QWEN_TTS_MODEL=qwen3-tts-instruct-flash
# QWEN_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# QWEN_TTS_VOICE=Cherry
# QWEN_TTS_INSTRUCTIONS=请用标准普通话朗读，发音清晰准确……   (speaking style for Mandarin lines)
