# AI provider for the teacher: qwen (primary) or openai.
# Leave AI_PROVIDER unset to use Qwen when a Qwen key is present, else OpenAI.
AI_PROVIDER=qwen

# Qwen (Alibaba Cloud Model Studio, OpenAI-compatible endpoint)
QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# International (Singapore) is the default; for mainland China use:
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# TUTOR_TIMEZONE=Asia/Shanghai
