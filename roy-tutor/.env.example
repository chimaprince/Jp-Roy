# Roy Medical Chinese Tutor - copy to .env and fill in. Never commit .env.
# Qwen (Alibaba Cloud Model Studio) is the only AI provider. The key is read
# only by the server; the browser never sees it.
DASHSCOPE_API_KEY=

# --- The AI teacher (chat, OpenAI-compatible API) ---
# Use the compatible-mode URL of your workspace and a model it authorises.
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.8-flash
# QWEN_ENABLE_THINKING=false
# Per-request timeout in milliseconds (one retry after a failure):
# QWEN_TIMEOUT_MS=30000

# --- Speech recognition (ASR) ---
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash
# Your Singapore workspace host (Model Studio › your workspace; replace
# <WORKSPACE_ID>). For qwen-audio-*-asr the tutor calls the DashScope native
# endpoint on this host: .../api/v1/services/aigc/multimodal-generation/generation
# QWEN_ASR_BASE_URL=https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Or the full ASR endpoint (overrides the one derived above):
# QWEN_ASR_URL=https://<WORKSPACE_ID>.ap-southeast-1.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# The current term as recognition context (on by default):
# QWEN_ASR_CONTEXT=on

# --- The teacher's voice (TTS) ---
# QWEN_TTS_MODEL=qwen3-tts-instruct-flash
# QWEN_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# QWEN_TTS_VOICE=Cherry
# QWEN_TTS_INSTRUCTIONS=请用标准普通话朗读，发音清晰准确……   (speaking style for Mandarin lines)

# --- The tutor ---
# Passcode for every API route, so others on the same network cannot use your quota:
# TUTOR_ACCESS_CODE=
# Decides when a new study day (and its review) starts:
# TUTOR_TIMEZONE=Asia/Singapore

# --- Phone (npm run start:https) ---
# PORT=3443
# TUTOR_SETUP_PORT=3000
# TUTOR_HTTPS_HOSTS=
# Your own certificate instead of the generated development one:
# TUTOR_HTTPS_CERT=
# TUTOR_HTTPS_KEY=
