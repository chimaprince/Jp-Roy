{
  "name": "roy-medical-chinese-tutor",
  "version": "1.0.0",
  "private": true,
  "description": "Voice-first medical Chinese tutor for Roy, driven by the JH Medics Volume 1 curriculum.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "start:https": "node --disable-warning=ExperimentalWarning scripts/start-https.mjs",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-curriculum.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "check-ai": "node --disable-warning=ExperimentalWarning scripts/check-ai.mjs",
    "try-word1": "node --disable-warning=ExperimentalWarning scripts/try-word1.mjs",
    "check-voice": "node --disable-warning=ExperimentalWarning scripts/check-voice.mjs"
  },
  "dependencies": {
    "node-forge": "^1.4.0",
    "openai": "^7.23.0",
    "pinyin-pro": "^3.29.4"
  }
}
